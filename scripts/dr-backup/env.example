# Copy to /etc/plaerrdeifl-dr-backup/env with mode 0600.
# Never commit the real file or the restic password.

RESTIC_REPOSITORY=s3:s3.example.invalid/plaerrdeifl-prod-dr
RESTIC_PASSWORD_FILE=/etc/plaerrdeifl-dr-backup/restic-password

# Existing authenticated Supabase CLI account on acer01.
SUPABASE_PROJECT_REF=wplescvhlgctynkfwvrj
SUPABASE_CLI_USER=benny
SUPABASE_CLI_HOME=/home/benny

LOCAL_SNAPSHOT_ROOT=/mnt/backup/ServerBackup/snapshots
LOCAL_SNAPSHOT_MAX_AGE_HOURS=30
STAGING_ROOT=/var/lib/plaerrdeifl-dr-backup/staging

RESTIC_HOST=acer01
RESTIC_TAG=plaerrdeifl-prod-dr
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Live Chromium/WPP profiles may not be crash-consistent. Leave disabled unless
# explicitly accepted; QR re-pairing remains the safe fallback.
INCLUDE_WPP_SESSION=0
